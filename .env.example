# --- Provider keys (all server-side only; never shipped to a browser) ---
OPENROUTER_API_KEY=          # openrouter.ai → Keys
PARALLEL_API_KEY=            # platform.parallel.ai → API Keys
EXA_API_KEY=                 # dashboard.exa.ai → API Keys
OPENAI_API_KEY=              # embeddings only (M3 recall) — OpenRouter has no embedding models

# --- Supabase (either path enables persistence; Data API preferred once available) ---
DATABASE_URL=                # direct Postgres: postgresql://postgres:PASSWORD@db.<ref>.supabase.co:5432/postgres
SUPABASE_URL=                # Project Settings → API → Project URL
SUPABASE_SERVICE_ROLE_KEY=   # Settings → API Keys → sb_secret_... (server-side ONLY; needed for M1+ realtime/storage)

# --- Model slots (PRD §10). Filled with evidence by `daybrief eval`, not by opinion. ---
MODEL_FAST=anthropic/claude-haiku-4.5
MODEL_SYNTH=anthropic/claude-opus-5
MODEL_DEEP=anthropic/claude-opus-5
EMBEDDING_MODEL=openai/text-embedding-3-large

# Synth candidates `daybrief eval` compares when --models isn't given
EVAL_SYNTH_MODELS=qwen/qwen3.8-max,anthropic/claude-opus-5,moonshotai/kimi-k3

# --- Research config ---
PARALLEL_PROCESSOR_BRIEF=pro   # lite|base|core|pro|ultra… (-fast variants trade freshness for speed)
PARALLEL_PROCESSOR_DEEP=ultra
SEARCH_DEFAULT=exa             # generic web-search tool default: exa | parallel

# --- M1 nightly pipeline (each degrades gracefully except Google, which the calendar needs) ---
FIRM_DOMAIN=categoryvc.com
APP_URL=http://localhost:3000  # deployed URL in prod (redirect URI host + reconnect links)
# Google auth, preferred path: per-partner OAuth. Cloud Console → APIs & Services →
# OAuth consent screen (Audience: Internal) → Credentials → OAuth client (Web),
# redirect URI ${APP_URL}/api/google/callback. Partners connect at /api/google/connect.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Alternative: service account + domain-wide delegation (zero-touch, needs Workspace admin)
GOOGLE_SERVICE_ACCOUNT_JSON=
AFFINITY_API_KEY=              # Affinity → Settings → API
AFFINITY_PORTFOLIO_LIST_IDS=   # optional: comma-separated list IDs (beats name matching)
AFFINITY_LP_LIST_IDS=          # optional: comma-separated list IDs
SLACK_BOT_TOKEN=               # xoxb-… from the daybrief Slack app
SLACK_OPS_CHANNEL=             # channel ID (C…) for run summaries
PARALLEL_WEBHOOK_URL=          # Inngest webhook-intake URL (https://inn.gs/e/...) for task completion events
# INNGEST_EVENT_KEY / INNGEST_SIGNING_KEY: set automatically by the Vercel integration.
INNGEST_DEV=1                  # local dev only — remove in production
